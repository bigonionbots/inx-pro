{
  "name": "opencore_aacdec",
  "version": "4.1.2+r2.1",
  "description": "PacketVideo AAC / HE-AAC / HE-AAC v2 decoder from Android's frameworks/av (android-4.1.2_r2.1, unmodified sources)",
  "license": "Apache-2.0",
  "platforms": "espressif32",
  "build": {
    "srcDir": "src",
    "srcFilter": [
      "+<*.cpp>"
    ],
    "includeDir": "src",
    "flags": [
      "-DAAC_PLUS",
      "-DHQ_SBR",
      "-DPARAMETRICSTEREO",
      "-DOSCL_IMPORT_REF=",
      "-DOSCL_EXPORT_REF=",
      "-DOSCL_UNUSED_ARG=",
      "-O2", "-Wno-narrowing",
      "-w"
    ]
  }
}

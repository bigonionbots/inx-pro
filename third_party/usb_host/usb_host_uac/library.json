{
  "name": "usb_host_uac",
  "version": "1.5.0",
  "description": "Espressif USB Host UAC 1.0 driver (vendored ESP-IDF component, unmodified sources)",
  "license": "Apache-2.0",
  "platforms": "espressif32",
  "build": {
    "srcDir": ".",
    "srcFilter": [
      "+<*.c>"
    ],
    "includeDir": "include",
    "flags": [
      "-DUSB_HOST_UAC_VER_MAJOR=1",
      "-DUSB_HOST_UAC_VER_MINOR=5",
      "-DUSB_HOST_UAC_VER_PATCH=0"
    ]
  }
}
